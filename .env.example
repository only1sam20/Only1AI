# Copy this file to .env and set real values locally. Never commit secrets.
POSTGRES_DB=only1ai
POSTGRES_USER=only1ai
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=only1ai
DATABASE_USER=only1ai
DATABASE_PASSWORD=change-me-locally
REDIS_PORT=6379
API_PORT=3001
WEB_PORT=3000
AI_PORT=8000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Password-reset links are one-time tokens. Use a short duration in production.
PASSWORD_RESET_TTL=1h
OPENAI_API_KEY=
# OpenAI model used by the AI service. Keep provider-specific values out of the web client.
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=20
# Internal NestJS -> FastAPI connection. Generate a long random shared token.
# Never use a user JWT or expose this token through NEXT_PUBLIC_* variables.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
# Twelve Data is the server-side source for OHLC, quotes, and scanner inputs.
# Never expose this key through NEXT_PUBLIC_* variables.
TWELVE_DATA_API_KEY=
# Per-process cache and provider-request budget. Match the budget to your plan.
MARKET_DATA_CACHE_TTL_MS=60000
MARKET_DATA_CACHE_MAX_ENTRIES=200
MARKET_DATA_TIMEOUT_MS=8000
MARKET_DATA_MAX_REQUESTS_PER_MINUTE=8
# Resend sends account verification, password recovery, and operational emails.
RESEND_API_KEY=
EMAIL_FROM=Only1AI <onboarding@example.com>
# TradingView Lightweight Charts renders sourced candles without this flag.
# This flag is reserved for a future licensed Advanced Charting Library.
TRADINGVIEW_ENABLED=false
WEB_ORIGIN=http://localhost:3000
